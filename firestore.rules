rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 1. PRINCIPE DE SÉCURITÉ MAJEUR : FERMETURE TOTALE PAR DÉFAUT (DENY ALL)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. FONCTIONS D'AUTHENTIFICATION, RÔLES ET INTÉGRITÉ (ABAC / RBAC)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function getUserStatus() {
      let data = getUserData();
      return data != null ? (data.statut != null ? data.statut : data.status) : null;
    }

    // Un utilisateur suspendu voit tous ses privilèges révoqués
    function isNotSuspended() {
      let s = getUserStatus();
      return s == null || s != 'suspendu';
    }

    function isSuperAdmin() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (
        r == 'super_admin' || r == 'president' || r == 'president_fondateur' || r == 'admin'
      );
    }

    function isVicePresident() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'vice_president' || isSuperAdmin());
    }

    function isSecretaire() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'secretaire' || isSuperAdmin());
    }

    function isTresorier() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r in ['tresorier', 'treasurer'] || isSuperAdmin());
    }

    function isCommunicateur() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'communicateur' || isSuperAdmin());
    }

    function isConseiller() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'conseiller' || isSuperAdmin());
    }

    function isBureau() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (
        r in ['super_admin', 'president', 'president_fondateur', 'vice_president', 
              'secretaire', 'tresorier', 'communicateur', 'conseiller', 'admin_bureau', 'admin']
      );
    }

    function isMember() {
      return isSignedIn() && isNotSuspended();
    }

    function isRegularMember() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && r in ['membre', 'member'];
    }

    // Gestion des rôles : seuls Président, Président fondateur,
    // Super administrateur et Administrateur peuvent attribuer des rôles.
    function canChangeUserRole(userId) {
      let actorRole = getUserRole();
      let targetRole = resource.data.role;
      let nextRole = request.resource.data.role;
      return isSignedIn()
        && isNotSuspended()
        && actorRole in ['super_admin', 'president', 'president_fondateur', 'admin']
        && userId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'roleUpdatedAt', 'roleUpdatedBy'
        ])
        && nextRole in [
          'super_admin', 'president_fondateur', 'president', 'admin',
          'admin_bureau', 'vice_president', 'secretaire', 'tresorier',
          'conseiller', 'communicateur', 'membre'
        ]
        && request.resource.data.roleUpdatedAt == request.time
        && request.resource.data.roleUpdatedBy == request.auth.uid
        && (actorRole == 'super_admin' || nextRole != 'super_admin')
        && (actorRole == 'super_admin' || targetRole != 'super_admin')
        && (actorRole in ['super_admin', 'president', 'president_fondateur']
            || (actorRole == 'admin'
                && targetRole != 'president'
                && targetRole != 'president_fondateur'
                && targetRole != 'admin'
                && nextRole != 'president'
                && nextRole != 'president_fondateur'
                && nextRole != 'admin'));
    }

    // =========================================================================
    // 3. PROTECTION CRITIQUE DES PROFILS UTILISATEURS (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Lecture : L'utilisateur pour son propre compte, ou le bureau habilité pour la gestion des membres
      allow read: if isOwner(userId) || isSuperAdmin() || isSecretaire() || isVicePresident();

      // Création :
      // - Par le bureau habilité (Président ou Secrétaire Général via secondaryAuth)
      // - Auto-inscription : rôle strictement forcé à membre / member et statut non privilégié
      allow create: if isSuperAdmin() || isSecretaire() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['membre', 'member']) &&
        (!('statut' in request.resource.data) || request.resource.data.statut in ['actif', 'en_attente']) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
      );

      // Modification :
      // - Le bureau habilité peut administrer les rôles et statuts
      // - L'utilisateur propriétaire peut mettre à jour ses coordonnées personnelles,
      //   mais IL NE PEUT JAMAIS modifier son rôle, son statut, son solde ou ses privilèges
      allow update: if (
        (isSuperAdmin() || isSecretaire()) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          canChangeUserRole(userId)
        )
      ) || (
        isOwner(userId) && isNotSuspended() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roleUpdatedAt', 'roleUpdatedBy',
          'statut', 'status', 'permissions', 'isAdmin', 'solde', 'cotisation'
        ])
      );

      // Suppression : Strictement réservée à la haute administration
      allow delete: if isSuperAdmin() || isSecretaire();
    }

    // =========================================================================
    // 4. ESPACE PUBLIC (Landing Page, Informations Officielles & Contact)
    // =========================================================================
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /domains/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /domaines/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur() || isVicePresident();
    }

    match /actualites/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /activites/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /temoignages/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isBureau();
    }

    match /public_reports/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSecretaire() || isVicePresident();
    }

    match /partners/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    match /partenaires/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    // Formulaire de contact public (Création ouverte, administration réservée)
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isCommunicateur() || isSecretaire();
    }

    // Demandes d'adhésion publiques
    match /membership_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isSecretaire() || isVicePresident();
    }

    match /adhesions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isSecretaire() || isVicePresident();
    }

    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isCommunicateur();
    }

    // =========================================================================
    // 5. COLLECTIONS FINANCIÈRES (CLOISONNEMENT STRICT — TRÉSORIER / PRÉSIDENT)
    // =========================================================================
    match /finances/{docId} {
      // Le membre consulte uniquement ses propres déclarations et reçus.
      allow read: if isTresorier() || isSuperAdmin() || (
        isRegularMember() && (
          (resource.data.keys().hasAny(['memberId']) && resource.data.memberId == request.auth.uid) ||
          (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid) ||
          (resource.data.keys().hasAny(['uid']) && resource.data.uid == request.auth.uid)
        )
      );

      // Un membre peut uniquement déclarer une cotisation pour son UID.
      // Il ne peut ni créer une recette validée, ni choisir le statut du paiement.
      allow create: if isTresorier() || isSuperAdmin() || (
        isRegularMember()
        && request.resource.data.keys().hasOnly([
          'type', 'category', 'memberId', 'memberName', 'montant',
          'period', 'payment', 'reference', 'status', 'createdAt'
        ])
        && request.resource.data.type == 'cotisation_demande'
        && request.resource.data.category == 'cotisation'
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() <= 120
        && request.resource.data.montant is number
        && request.resource.data.montant > 0
        && request.resource.data.period is string
        && request.resource.data.period.size() <= 20
        && request.resource.data.payment in ['orange_money', 'moov_money', 'airtel_money', 'especes', 'virement']
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0
        && request.resource.data.reference.size() <= 100
        && request.resource.data.status == 'en_attente'
        && request.resource.data.createdAt == request.time
      );

      // Seuls trésorier et administration habilitée peuvent traiter une demande.
      allow update: if (isTresorier() || isSuperAdmin()) && (
        resource.data.type != 'cotisation_demande' ||
        request.resource.data.status != 'rejete' ||
        (
          request.resource.data.rejectionReason is string
          && request.resource.data.rejectionReason.size() >= 5
          && request.resource.data.rejectionReason.size() <= 500
          && request.resource.data.rejectedBy == request.auth.uid
          && request.resource.data.rejectedAt == request.time
        )
      );
      allow delete: if isTresorier() || isSuperAdmin();
    }

    match /expenses/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /income/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /factures/{docId} {
      allow read: if isTresorier() || isSuperAdmin();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /transactions/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    // =========================================================================
    // 6. JOURNAUX D'AUDIT (INVIOLABILITÉ ET APPEND-ONLY RENFORCÉ — SEC-4C-01)
    // =========================================================================
    match /audit_logs/{docId} {
      // Seul le Président / Super Admin peut consulter les journaux de sécurité
      allow read: if isSuperAdmin();

      // Création append-only sécurisée :
      // - Utilisateur obligatoirement authentifié et non suspendu
      // - Anti-usurpation stricte : actorUid DOIT correspondre à l'UID de la requête auth
      // - Schéma minimal vérifié : action non vide (max 100 caractères), details et user bornés
      allow create: if isSignedIn() && isNotSuspended()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 100
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 1000))
        && (!('user' in request.resource.data) || (request.resource.data.user is string && request.resource.data.user.size() <= 100));

      // Immutabilité absolue : Modification et suppression strictement impossibles pour tous
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. REGISTRE DES MEMBRES & VALIDATIONS
    // =========================================================================
    match /members/{docId} {
      allow read: if isTresorier() || isSecretaire() || isVicePresident() || isSuperAdmin();
      allow create, update, delete: if isTresorier() || isSecretaire() || isSuperAdmin();
    }

    match /validations/{docId} {
      allow read: if isBureau();
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    // =========================================================================
    // 8. GOUVERNANCE, ADMINISTRATION ET SECRÉTARIAT
    // =========================================================================
    match /documents/{docId} {
      // Documents officiels partagés : lecture autorisée à tous les membres
      allow read: if isMember();
      // Gestion des documents : Secrétaire Général et Président
      allow create, update, delete: if isSecretaire() || isSuperAdmin();
    }

    match /pv/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isSecretaire() || isSuperAdmin();
    }

    match /convocations/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isSecretaire() || isSuperAdmin();
    }

    match /courriers/{docId} {
      allow read, write: if isSecretaire() || isSuperAdmin();
    }

    match /moderation/{docId} {
      allow read, write: if isSecretaire() || isSuperAdmin();
    }

    match /meetings/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /commissions/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /tasks/{docId} {
      allow read: if isBureau() || isMember();
      allow create, delete: if isBureau();
      // Un membre assigné peut cocher l'accomplissement d'une tâche
      allow update: if isBureau() || (
        isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt'])
      );
    }

    match /system/{docId} {
      // Configuration d'urgence ou de suppléance
      allow read: if isBureau() || (isMember() && docId == 'suppleance');
      allow write: if isSuperAdmin() || (isVicePresident() && docId == 'suppleance');
    }

    match /suppleance_history/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isVicePresident() || isSuperAdmin();
    }

    match /board_messages/{docId} {
      // Messagerie interne du bureau exécutif
      allow read, write: if isBureau();
    }

    match /avis/{docId} {
      allow read, write: if isConseiller() || isSuperAdmin();
    }

    match /conflits/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSuperAdmin();
    }

    match /projets/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSuperAdmin();
    }

    match /objectives/{docId} {
      allow read, write: if isVicePresident() || isSuperAdmin();
    }

    match /rapports/{docId} {
      allow read, write: if isBureau();
    }

    match /rapports_delegues/{docId} {
      allow read, write: if isBureau();
    }

    // =========================================================================
    // 9. VIE ASSOCIATIVE ET ESPACE MEMBRES
    // =========================================================================
    match /missions_benevolat/{docId} {
      allow read: if isMember();
      allow create, delete: if isVicePresident() || isSuperAdmin();
      // Les membres peuvent s'inscrire / se désinscrire des missions de bénévolat
      allow update: if isVicePresident() || isSuperAdmin() || (
        isMember() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['inscrits', 'volunteers', 'participants'])
      );
    }

    match /forum/{docId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isSuperAdmin() || (
        isMember() && resource.data.authorId == request.auth.uid
      );
    }

    match /votes/{docId} {
      allow read: if isMember();
      allow create, delete: if isSuperAdmin() || isSecretaire();
      // Un membre peut participer en enregistrant son vote sans modifier la structure de la session
      allow update: if isSuperAdmin() || isSecretaire() || isMember();
    }

    match /notifications/{docId} {
      allow read: if isMember() && (
        resource.data.userId == request.auth.uid || resource.data.target == 'all' || isBureau()
      );
      allow write: if isBureau();
    }

    match /messages/{docId} {
      allow read: if isMember() && (
        resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid || isBureau()
      );
      allow create: if isMember();
      allow update, delete: if isBureau() || (
        isMember() && resource.data.senderId == request.auth.uid
      );
    }

    match /ag_events/{docId} {
      allow read: if isMember();
      allow write: if isSuperAdmin() || isSecretaire();
    }

    match /media/{docId} {
      allow read: if isBureau();
      allow write: if isCommunicateur() || isSuperAdmin();
    }

    match /editorial_calendar/{docId} {
      allow read, write: if isCommunicateur() || isSuperAdmin();
    }
  }
}
