rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['nom', 'email', 'tel', 'sujet', 'message', 'createdAt'])
                    && request.resource.data.keys().size() == 6
                    && request.resource.data.nom is string && request.resource.data.nom.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.size() <= 100
                    && request.resource.data.tel is string && request.resource.data.tel.size() <= 50
                    && request.resource.data.sujet is string && request.resource.data.sujet.size() <= 100
                    && request.resource.data.message is string && request.resource.data.message.size() <= 2000
                    && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null;
    }

    match /adhesions/{adhesionId} {
      allow create: if request.resource.data.keys().hasAll(['nom', 'email', 'tel', 'statut', 'createdAt'])
                    && request.resource.data.keys().size() == 5
                    && request.resource.data.nom is string && request.resource.data.nom.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.size() <= 100
                    && request.resource.data.tel is string && request.resource.data.tel.size() <= 50
                    && request.resource.data.statut == 'En attente de validation'
                    && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null;
    }
    
    match /actualites/{actuId} {
      allow read: if true;
      allow write: if false; // Only written via console or admin sdk
    }
  }
}
