rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 1. PRINCIPE DE SÉCURITÉ MAJEUR : FERMETURE TOTALE PAR DÉFAUT (DENY ALL)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. FONCTIONS D'AUTHENTIFICATION, RÔLES ET INTÉGRITÉ (ABAC / RBAC)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function getUserStatus() {
      let data = getUserData();
      return data != null ? (data.statut != null ? data.statut : data.status) : null;
    }

    // Un utilisateur suspendu voit tous ses privilèges révoqués
    function isNotSuspended() {
      let s = getUserStatus();
      return s == null || s != 'suspendu';
    }

    // Les privilèges techniques sont réservés aux comptes d'administration technique.
    function isSystemAdmin() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && r in ['super_admin', 'admin'];
    }

    function isActiveUser() {
      return isSignedIn() && getUserRole() != null && isNotSuspended();
    }

    function isPresident() { return isActiveUser() && getUserRole() == 'president'; }
    function isPresidentFondateur() { return isActiveUser() && getUserRole() == 'president_fondateur'; }
    function isVicePresident() { return isActiveUser() && getUserRole() == 'vice_president'; }
    function isSecretaire() { return isActiveUser() && getUserRole() in ['secretaire_general', 'secretaire']; }
    function isSecretaireAdjoint() { return isActiveUser() && getUserRole() == 'secretaire_adjoint'; }
    function isTresorier() { return isActiveUser() && getUserRole() in ['tresorier', 'treasurer']; }
    function isTresorierAdjoint() { return isActiveUser() && getUserRole() == 'tresorier_adjoint'; }
    function isCommissaireAuxComptes() { return isActiveUser() && getUserRole() == 'commissaire_aux_comptes'; }
    function isCommunicateur() { return isActiveUser() && getUserRole() == 'communicateur'; }
    function isConseiller() { return isActiveUser() && getUserRole() == 'conseiller'; }

    // Le Fondateur, les adjoints et le Commissaire aux Comptes ne reçoivent
    // aucun privilège opérationnel par héritage.
    function isBureau() {
      return isSystemAdmin() || (
        isActiveUser() && getUserRole() in [
          'president', 'vice_president', 'secretaire_general', 'secretaire',
          'tresorier', 'communicateur', 'conseiller', 'admin_bureau'
        ]
      );
    }

    function isTaskManager() {
      return isSystemAdmin() || (
        isActiveUser() && getUserRole() in [
          'president', 'vice_president', 'secretaire_general', 'secretaire', 'admin_bureau'
        ]
      );
    }

    function isAssignedTaskToCurrentRole() {
      let role = getUserRole();
      let assignedTo = resource.data.assignedTo;
      return isActiveUser() && ('assignedTo' in resource.data) && (
        assignedTo == role ||
        (role == 'secretaire_general' && assignedTo == 'secretaire') ||
        (role == 'tresorier' && assignedTo == 'treasurer') ||
        (role == 'membre' && assignedTo == 'member')
      );
    }

    function isMember() {
      return isSignedIn() && isNotSuspended() && getUserRole() in ['membre', 'member'];
    }

    function isRegularMember() { return isMember(); }

    // =========================================================================
    // 3. PROTECTION CRITIQUE DES PROFILS UTILISATEURS (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Lecture : L'utilisateur pour son propre compte, ou le bureau habilité pour la gestion des membres
      allow read: if isOwner(userId) || isSystemAdmin() || isSecretaire() || isVicePresident();

      // Création :
      // - Par le bureau habilité (Président ou Secrétaire Général via secondaryAuth)
      // - Auto-inscription : rôle strictement forcé à membre / member et statut non privilégié
      allow create: if isSystemAdmin() || isSecretaire() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['membre', 'member']) &&
        (!('statut' in request.resource.data) || request.resource.data.statut in ['actif', 'en_attente']) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
      );

      // Modification :
      // - Le bureau habilité peut administrer les rôles et statuts
      // - L'utilisateur propriétaire peut mettre à jour ses coordonnées personnelles,
      //   mais IL NE PEUT JAMAIS modifier son rôle, son statut, son solde ou ses privilèges
      allow update: if isSystemAdmin() || isSecretaire() || (
        isOwner(userId) && isNotSuspended() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'statut', 'status', 'permissions', 'isAdmin', 'solde', 'cotisation'
        ])
      );

      // Suppression : Strictement réservée à la haute administration
      allow delete: if isSystemAdmin() || isSecretaire();
    }

    // =========================================================================
    // 4. ESPACE PUBLIC (Landing Page, Informations Officielles & Contact)
    // =========================================================================
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /domains/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /domaines/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur() || isVicePresident();
    }

    match /actualites/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /activites/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /temoignages/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isCommunicateur();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isBureau();
    }

    match /public_reports/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isSecretaire() || isVicePresident();
    }

    match /partners/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isVicePresident() || isConseiller();
    }

    match /partenaires/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isVicePresident() || isConseiller();
    }

    // Formulaire de contact public (Création ouverte, administration réservée)
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isSystemAdmin() || isCommunicateur() || isSecretaire();
    }

    // Demandes d'adhésion publiques
    match /membership_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSystemAdmin() || isSecretaire() || isVicePresident();
    }

    match /adhesions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSystemAdmin() || isSecretaire() || isVicePresident();
    }

    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isSystemAdmin() || isCommunicateur();
    }

    // =========================================================================
    // 5. COLLECTIONS FINANCIÈRES (CLOISONNEMENT STRICT — TRÉSORIER / PRÉSIDENT)
    // =========================================================================
    match /finances/{docId} {
      // Le Commissaire aux Comptes et le Trésorier adjoint disposent d'une lecture seule.
      allow read: if isTresorier() || isTresorierAdjoint() || isCommissaireAuxComptes() || isSystemAdmin() || (
        isRegularMember() && (
          (resource.data.keys().hasAny(['memberId']) && resource.data.memberId == request.auth.uid) ||
          (resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid) ||
          (resource.data.keys().hasAny(['uid']) && resource.data.uid == request.auth.uid)
        )
      );

      allow create: if isTresorier() || isSystemAdmin() || (
        isRegularMember()
        && request.resource.data.keys().hasOnly([
          'type', 'category', 'memberId', 'memberName', 'montant',
          'period', 'payment', 'reference', 'status', 'createdAt'
        ])
        && request.resource.data.type == 'cotisation_demande'
        && request.resource.data.category == 'cotisation'
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() <= 120
        && request.resource.data.montant is number
        && request.resource.data.montant > 0
        && request.resource.data.period is string
        && request.resource.data.period.size() <= 20
        && request.resource.data.payment in ['orange_money', 'moov_money', 'airtel_money', 'especes', 'virement']
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0
        && request.resource.data.reference.size() <= 100
        && request.resource.data.status == 'en_attente'
        && request.resource.data.createdAt == request.time
      );

      // Le Trésorier seul valide ou rejette une demande en attente.
      // Les attributs initiaux du paiement restent immuables.
      allow update: if (isTresorier() || isSystemAdmin())
        && resource.data.type == 'cotisation_demande'
        && resource.data.status == 'en_attente'
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.montant == resource.data.montant
        && request.resource.data.period == resource.data.period
        && request.resource.data.payment == resource.data.payment
        && request.resource.data.reference == resource.data.reference
        && (
          (
            request.resource.data.status == 'valide'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'validatedAt', 'validatedBy', 'validatedByName', 'receiptNumber'
            ])
            && request.resource.data.validatedAt == request.time
            && request.resource.data.validatedBy == request.auth.uid
            && request.resource.data.validatedByName is string
            && request.resource.data.receiptNumber is string
          )
          ||
          (
            request.resource.data.status == 'rejete'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejectionReason', 'rejectedAt', 'rejectedBy', 'rejectedByName'
            ])
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 5
            && request.resource.data.rejectionReason.size() <= 500
            && request.resource.data.rejectedAt == request.time
            && request.resource.data.rejectedBy == request.auth.uid
            && request.resource.data.rejectedByName is string
          )
        );

      allow delete: if false;
    }

    match /expenses/{docId} {
      allow read: if isTresorier() || isTresorierAdjoint() || isCommissaireAuxComptes() || isVicePresident() || isSystemAdmin();
      allow create, update: if isTresorier() || isSystemAdmin();
      allow delete: if false;
    }

    match /income/{docId} {
      allow read: if isTresorier() || isTresorierAdjoint() || isCommissaireAuxComptes() || isVicePresident() || isSystemAdmin();
      allow create, update: if isTresorier() || isSystemAdmin();
      allow delete: if false;
    }

    match /factures/{docId} {
      allow read: if isTresorier() || isTresorierAdjoint() || isCommissaireAuxComptes() || isSystemAdmin();
      allow create, update: if isTresorier() || isSystemAdmin();
      allow delete: if false;
    }

    match /transactions/{docId} {
      allow read: if isTresorier() || isTresorierAdjoint() || isCommissaireAuxComptes() || isVicePresident() || isSystemAdmin();
      allow create, update: if isTresorier() || isSystemAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // 6. JOURNAUX D'AUDIT (INVIOLABILITÉ ET APPEND-ONLY RENFORCÉ — SEC-4C-01)
    // =========================================================================
    match /audit_logs/{docId} {
      allow read: if isPresident() || isSystemAdmin();
      allow create: if isActiveUser()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 100
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 1000))
        && (!('user' in request.resource.data) || (request.resource.data.user is string && request.resource.data.user.size() <= 100));
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. REGISTRE DES MEMBRES & VALIDATIONS
    // =========================================================================
    match /members/{docId} {
      allow read: if isTresorier() || isTresorierAdjoint() || isSecretaire() || isSecretaireAdjoint() || isVicePresident() || isSystemAdmin();
      allow create, update, delete: if isTresorier() || isSecretaire() || isSystemAdmin();
    }

    match /validations/{docId} {
      allow read: if isBureau();
      allow write: if isSystemAdmin() || isVicePresident() || isConseiller();
    }

    // =========================================================================
    // 8. GOUVERNANCE, ADMINISTRATION ET SECRÉTARIAT
    // =========================================================================
    match /documents/{docId} {
      allow read: if isMember() || isBureau() || isSecretaireAdjoint();
      allow create, update, delete: if isSecretaire() || isPresident() || isSystemAdmin();
    }

    match /pv/{docId} {
      allow read: if isBureau() || isMember() || isSecretaireAdjoint();
      allow write: if isSecretaire() || isSystemAdmin();
    }

    match /convocations/{docId} {
      allow read: if isBureau() || isMember() || isSecretaireAdjoint();
      allow write: if isSecretaire() || isSystemAdmin();
    }

    match /courriers/{docId} {
      allow read: if isSecretaire() || isSecretaireAdjoint() || isSystemAdmin();
      allow write: if isSecretaire() || isSystemAdmin();
    }

    match /moderation/{docId} {
      allow read: if isSecretaire() || isSecretaireAdjoint() || isSystemAdmin();
      allow write: if isSecretaire() || isSystemAdmin();
    }

    match /meetings/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /commissions/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /tasks/{docId} {
      // Les responsables désignés consultent le tableau de délégation complet.
      // Les autres rôles ne consultent que les tâches affectées à leur rôle.
      allow read: if isTaskManager() || isAssignedTaskToCurrentRole();

      allow create: if isTaskManager()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.assignedTo in [
          'president', 'vice_president', 'secretaire', 'secretaire_general',
          'secretaire_adjoint', 'tresorier', 'treasurer', 'tresorier_adjoint',
          'communicateur', 'conseiller', 'commissaire_aux_comptes', 'membre', 'member'
        ]
        && request.resource.data.createdAt == request.time;

      allow update: if isTaskManager() || (
        isAssignedTaskToCurrentRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt'])
        && request.resource.data.completed is bool
        && (
          (request.resource.data.completed == true && request.resource.data.completedAt == request.time)
          || (request.resource.data.completed == false && request.resource.data.completedAt == null)
        )
      );
      allow delete: if isTaskManager();
    }

    match /system/{docId} {
      allow read: if isBureau() || (isMember() && docId == 'suppleance');
      allow write: if isSystemAdmin() || (isVicePresident() && docId == 'suppleance');
    }

    match /suppleance_history/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isVicePresident() || isSystemAdmin();
    }

    match /board_messages/{docId} {
      // Messagerie interne du bureau exécutif
      allow read, write: if isBureau();
    }

    match /avis/{docId} {
      allow read, write: if isConseiller() || isSystemAdmin();
    }

    match /conflits/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSystemAdmin();
    }

    match /projets/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSystemAdmin();
    }

    match /objectives/{docId} {
      allow read, write: if isVicePresident() || isSystemAdmin();
    }

    match /rapports/{docId} {
      allow read, write: if isBureau();
    }

    match /rapports_delegues/{docId} {
      allow read, write: if isBureau();
    }

    // =========================================================================
    // 9. VIE ASSOCIATIVE ET ESPACE MEMBRES
    // =========================================================================
    match /missions_benevolat/{docId} {
      allow read: if isMember();
      allow create, delete: if isVicePresident() || isSystemAdmin();
      // Les membres peuvent s'inscrire / se désinscrire des missions de bénévolat
      allow update: if isVicePresident() || isSystemAdmin() || (
        isMember() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['inscrits', 'volunteers', 'participants'])
      );
    }

    match /forum/{docId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isSystemAdmin() || (
        isMember() && resource.data.authorId == request.auth.uid
      );
    }

    match /votes/{docId} {
      allow read: if isMember();
      allow create, delete: if isSystemAdmin() || isSecretaire();
      // Un membre peut participer en enregistrant son vote sans modifier la structure de la session
      allow update: if isSystemAdmin() || isSecretaire() || isMember();
    }

    match /notifications/{docId} {
      allow read: if isMember() && (
        resource.data.userId == request.auth.uid || resource.data.target == 'all' || isBureau()
      );
      allow write: if isBureau();
    }

    match /messages/{docId} {
      allow read: if (isMember() || isBureau()) && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isBureau()
      );
      allow create: if isMember() || isBureau();
      allow update, delete: if isBureau() || (
        isMember() && resource.data.senderId == request.auth.uid
      );
    }

    match /ag_events/{docId} {
      allow read: if isMember();
      allow write: if isSystemAdmin() || isSecretaire();
    }

    match /media/{docId} {
      allow read: if isBureau();
      allow write: if isCommunicateur() || isSystemAdmin();
    }

    match /editorial_calendar/{docId} {
      allow read, write: if isCommunicateur() || isSystemAdmin();
    }
  }
}
