rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. GLOBAL DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    
    function getUserRole() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    // Public / Unauthenticated Collections
    match /site_config/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /domains/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /news/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /actualites/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /public_reports/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /contact_messages/{docId} { allow create: if true; allow read, update, delete: if isSignedIn(); }
    match /membership_requests/{docId} { allow create: if true; allow read, update, delete: if isSignedIn(); }
    match /adhesions/{docId} { allow create: if true; allow read, update, delete: if isSignedIn(); }

    // Authenticated Collections (Members & Bureau)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Simplified for testing
    }
    
    // Allow Signed-in users to read/write all operational collections for testing Phase 1
    match /{collection}/{docId} {
      allow read, write: if isSignedIn() && collection in [
        'audit_logs', 'avis', 'board_messages', 'commissions', 'conflits', 
        'convocations', 'courriers', 'documents', 'editorial_calendar', 
        'expenses', 'factures', 'finances', 'forum', 'income', 'media', 
        'meetings', 'members', 'moderation', 'notifications', 'objectives', 
        'partenaires', 'partners', 'projets', 'pv', 'rapports', 
        'suppleance_history', 'tasks', 'votes', 'ag_events', 'rapports_delegues',
        'transactions', 'messages', 'missions_benevolat'
      ];
    }
  }
}
