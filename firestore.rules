rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 1. PRINCIPE DE SÉCURITÉ MAJEUR : FERMETURE TOTALE PAR DÉFAUT (DENY ALL)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. FONCTIONS D'AUTHENTIFICATION, RÔLES ET INTÉGRITÉ (ABAC / RBAC)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function getUserStatus() {
      let data = getUserData();
      return data != null ? (data.statut != null ? data.statut : data.status) : null;
    }

    // Un utilisateur suspendu voit tous ses privilèges révoqués
    // Refus par défaut si le profil Firestore n'existe pas.
    function isNotSuspended() {
      return getUserData() != null && getUserStatus() != 'suspendu';
    }

    function isSuperAdmin() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (
        r == 'super_admin' || r == 'president' || r == 'president_fondateur' || r == 'admin'
      );
    }

    function isVicePresident() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'vice_president' || isSuperAdmin());
    }

    function isSecretaire() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'secretaire' || isSuperAdmin());
    }

    function isTresorier() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'tresorier' || isSuperAdmin());
    }

    function isCommunicateur() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'communicateur' || isSuperAdmin());
    }

    function isConseiller() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (r == 'conseiller' || isSuperAdmin());
    }

    function isBureau() {
      let r = getUserRole();
      return isSignedIn() && isNotSuspended() && (
        r in ['super_admin', 'president', 'president_fondateur', 'vice_president', 
              'secretaire', 'tresorier', 'communicateur', 'conseiller', 'admin_bureau', 'admin']
      );
    }

    // Un compte connecté n'est pas automatiquement un membre validé.
    // Seuls les profils actifs ou à jour accèdent à l'espace membres.
    function isMember() {
      return isSignedIn()
        && getUserData() != null
        && isNotSuspended()
        && getUserStatus() in ['actif', 'a_jour'];
    }

    // =========================================================================
    // 3. PROTECTION CRITIQUE DES PROFILS UTILISATEURS (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Lecture : L'utilisateur pour son propre compte, ou le bureau habilité pour la gestion des membres
      allow read: if isOwner(userId) || isSuperAdmin() || isSecretaire() || isVicePresident();

      // Création :
      // - La haute administration peut créer les profils nécessaires.
      // - Le secrétariat ne peut créer que des profils membres non privilégiés et en attente.
      // - L'auto-inscription reste limitée aux membres en attente.
      function isSafeMemberProfileCreate() {
        return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'statut', 'status',
          'createdAt', 'updatedAt', 'nom', 'telephone', 'phone', 'adresse',
          'address', 'profession', 'dateNaissance', 'isAdmin'
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['membre', 'member']) &&
        (!('statut' in request.resource.data) || request.resource.data.statut == 'en_attente') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'en_attente') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      }

      allow create: if isSuperAdmin() || (
        getUserRole() == 'secretaire' && isNotSuspended() &&
        isSafeMemberProfileCreate()
      ) || (
        isOwner(userId) &&
        isSafeMemberProfileCreate()
      );

      // Modification :
      // Seule la haute administration peut modifier un rôle. Le secrétariat peut gérer
      // les autres champs de profil, mais pas les rôles, permissions, privilèges ou soldes.
      // Un propriétaire ne peut jamais modifier son rôle, statut ou données sensibles.
      allow update: if isSuperAdmin() || (
        getUserRole() == 'secretaire' && isNotSuspended() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'permissions', 'isAdmin', 'solde', 'cotisation'
        ])
      ) || (
        isOwner(userId) && isNotSuspended() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'statut', 'status', 'permissions', 'isAdmin', 'solde', 'cotisation'
        ])
      );

      // Suppression : Strictement réservée à la haute administration
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. ESPACE PUBLIC (Landing Page, Informations Officielles & Contact)
    // =========================================================================
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /domains/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /domaines/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur() || isVicePresident();
    }

    match /actualites/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /activites/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /temoignages/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isCommunicateur();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isBureau();
    }

    match /public_reports/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSecretaire() || isVicePresident();
    }

    match /partners/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    match /partenaires/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    function validEmail(value) {
      return value is string
        && value.size() > 3
        && value.size() <= 254
        && value.matches('^[^ @]+@[^ @]+\\.[^ @]+$');
    }

    function validContactMessage() {
      return request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email)
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'nouveau'
        && request.resource.data.createdAt == request.time;
    }

    function validMembershipRequest() {
      return request.resource.data.keys().hasAll(['nom', 'email', 'telephone', 'categorie', 'motivation', 'statut', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nom', 'email', 'telephone', 'categorie', 'motivation', 'statut', 'createdAt'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 150
        && validEmail(request.resource.data.email)
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() >= 6
        && request.resource.data.telephone.size() <= 30
        && request.resource.data.categorie is string
        && request.resource.data.categorie.size() > 0
        && request.resource.data.categorie.size() <= 80
        && request.resource.data.motivation is string
        && request.resource.data.motivation.size() <= 3000
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.createdAt == request.time;
    }

    match /contact_messages/{docId} {
      allow create: if validContactMessage();
      allow read, update, delete: if isSuperAdmin() || isCommunicateur() || isSecretaire();
    }

    match /membership_requests/{docId} {
      allow create: if validMembershipRequest();
      allow read: if isSuperAdmin() || isSecretaire() || isVicePresident();
      // Les décisions passent par Cloud Functions (Admin SDK); aucune modification
      // directe du statut n'est autorisée depuis un client.
      allow update, delete: if false;
    }

    match /adhesions/{docId} {
      allow create: if validMembershipRequest();
      allow read: if isSuperAdmin() || isSecretaire() || isVicePresident();
      allow update, delete: if false;
    }

    match /newsletter/{docId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isSuperAdmin() || isCommunicateur();
    }

    // =========================================================================
    // 5. COLLECTIONS FINANCIÈRES (CLOISONNEMENT STRICT — TRÉSORIER / PRÉSIDENT)
    // =========================================================================
    match /finances/{docId} {
      // Lecture : Le Trésorier, le Président, ou le membre pour ses propres cotisations (reçu)
      allow read: if isTresorier() || isSuperAdmin() || (
        isMember() && resource.data.memberId == request.auth.uid
      );
      // Écriture, modification, suppression : Exclusivement Trésorier et Président
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /expenses/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /income/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /factures/{docId} {
      allow read: if isTresorier() || isSuperAdmin();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    match /transactions/{docId} {
      allow read: if isTresorier() || isSuperAdmin() || isVicePresident();
      allow create, update, delete: if isTresorier() || isSuperAdmin();
    }

    // =========================================================================
    // 6. JOURNAUX D'AUDIT (INVIOLABILITÉ ET APPEND-ONLY RENFORCÉ — SEC-4C-01)
    // =========================================================================
    match /audit_logs/{docId} {
      // Seul le Président / Super Admin peut consulter les journaux de sécurité
      allow read: if isSuperAdmin();

      // Création append-only sécurisée :
      // - Utilisateur obligatoirement authentifié et non suspendu
      // - Anti-usurpation stricte : actorUid DOIT correspondre à l'UID de la requête auth
      // - Schéma minimal vérifié : action non vide (max 100 caractères), details et user bornés
      allow create: if isSignedIn() && isNotSuspended()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 100
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 1000))
        && (!('user' in request.resource.data) || (request.resource.data.user is string && request.resource.data.user.size() <= 100));

      // Immutabilité absolue : Modification et suppression strictement impossibles pour tous
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. REGISTRE DES MEMBRES & VALIDATIONS
    // =========================================================================
    match /members/{docId} {
      allow read: if isTresorier() || isSecretaire() || isVicePresident() || isSuperAdmin();
      allow create, update, delete: if isTresorier() || isSecretaire() || isSuperAdmin();
    }

    match /validations/{docId} {
      allow read: if isBureau();
      allow write: if isSuperAdmin() || isVicePresident() || isConseiller();
    }

    // =========================================================================
    // 8. GOUVERNANCE, ADMINISTRATION ET SECRÉTARIAT
    // =========================================================================
    match /documents/{docId} {
      // Documents officiels partagés : lecture autorisée à tous les membres
      allow read: if isMember();
      // Gestion des documents : Secrétaire Général et Président
      allow create, update, delete: if isSecretaire() || isSuperAdmin();
    }

    match /pv/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isSecretaire() || isSuperAdmin();
    }

    match /convocations/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isSecretaire() || isSuperAdmin();
    }

    match /courriers/{docId} {
      allow read, write: if isSecretaire() || isSuperAdmin();
    }

    match /moderation/{docId} {
      allow read, write: if isSecretaire() || isSuperAdmin();
    }

    match /meetings/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /commissions/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isBureau();
    }

    match /tasks/{docId} {
      allow read: if isBureau() || isMember();
      allow create, delete: if isBureau();
      // Les tâches sont créées, modifiées et clôturées par le bureau uniquement.
      // L'interface assigne les tâches à des fonctions du bureau, pas à des membres ordinaires.
      allow update: if isBureau();
    }

    match /system/{docId} {
      // Configuration d'urgence ou de suppléance
      allow read: if isBureau() || (isMember() && docId == 'suppleance');
      allow write: if isSuperAdmin() || (isVicePresident() && docId == 'suppleance');
    }

    match /suppleance_history/{docId} {
      allow read: if isBureau() || isMember();
      allow write: if isVicePresident() || isSuperAdmin();
    }

    match /board_messages/{docId} {
      // Messagerie interne du bureau exécutif
      allow read, write: if isBureau();
    }

    match /avis/{docId} {
      allow read, write: if isConseiller() || isSuperAdmin();
    }

    match /conflits/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSuperAdmin();
    }

    match /projets/{docId} {
      allow read, write: if isConseiller() || isVicePresident() || isSuperAdmin();
    }

    match /objectives/{docId} {
      allow read, write: if isVicePresident() || isSuperAdmin();
    }

    match /rapports/{docId} {
      allow read, write: if isBureau();
    }

    match /rapports_delegues/{docId} {
      allow read, write: if isBureau();
    }

    // =========================================================================
    // 9. VIE ASSOCIATIVE ET ESPACE MEMBRES
    // =========================================================================
    match /missions_benevolat/{docId} {
      allow read: if isMember();
      allow create, delete: if isVicePresident() || isSuperAdmin();
      // Un membre ne peut modifier que la liste participants, en ajoutant ou retirant
      // uniquement son propre UID. Les champs de la mission restent protégés.
      allow update: if isVicePresident() || isSuperAdmin() || (
        isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && resource.data.participants is list
        && request.resource.data.participants is list
        && (
          (
            request.resource.data.participants.size() == resource.data.participants.size() + 1
            && request.resource.data.participants.hasAll(resource.data.participants)
            && request.resource.data.participants.hasAny([request.auth.uid])
            && !resource.data.participants.hasAny([request.auth.uid])
          )
          ||
          (
            resource.data.participants.size() == request.resource.data.participants.size() + 1
            && resource.data.participants.hasAll(request.resource.data.participants)
            && resource.data.participants.hasAny([request.auth.uid])
            && !request.resource.data.participants.hasAny([request.auth.uid])
          )
        )
      );
    }

    match /forum/{docId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'content', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt', 'title'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow update: if isMember()
        && (isSuperAdmin() || resource.data.authorId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'title'])
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200));
      allow delete: if isSuperAdmin() || (isMember() && resource.data.authorId == request.auth.uid);
    }

    match /votes/{docId} {
      // get autorise aussi la vérification d'un vote absent, sans exposer les votes des autres.
      allow get: if isSuperAdmin() || isSecretaire() || (
        isMember() && docId.matches('.*_' + request.auth.uid)
      );
      // Les listes de votes sont réservées au bureau habilité pour protéger le secret du scrutin.
      allow list: if isSuperAdmin() || isSecretaire();

      // Un vote est immuable et son identifiant déterministe (pollId_uid) empêche
      // un même compte de créer plusieurs votes pour la même résolution.
      allow create: if isMember()
        && getUserStatus() in ['a_jour', 'actif']
        && request.resource.data.keys().hasAll(['pollId', 'choice', 'memberId', 'timestamp'])
        && request.resource.data.keys().hasOnly(['pollId', 'choice', 'memberId', 'timestamp'])
        && request.resource.data.pollId is string
        && request.resource.data.memberId == request.auth.uid
        && docId == request.resource.data.pollId + '_' + request.auth.uid
        && request.resource.data.choice in ['pour', 'contre', 'abstention']
        && request.resource.data.timestamp == request.time
        && exists(/databases/$(database)/documents/ag_events/$(request.resource.data.pollId))
        && get(/databases/$(database)/documents/ag_events/$(request.resource.data.pollId)).data.status == 'ouvert_au_vote';

      // Aucun vote ne peut être modifié ou supprimé depuis le client.
      allow update, delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isMember() && (
        resource.data.userId == request.auth.uid || resource.data.target == 'all' || isBureau()
      );
      allow write: if isBureau();
    }

    match /messages/{docId} {
      allow read: if isMember() && (
        resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid || isBureau()
      );
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['senderId', 'recipientId', 'content', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'content', 'createdAt', 'subject'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.recipientId.size() <= 128
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow update: if isBureau() || (
        isMember()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
      );
      allow delete: if isBureau() || (isMember() && resource.data.senderId == request.auth.uid);
    }

    match /ag_events/{docId} {
      allow read: if isMember();
      allow write: if isSuperAdmin() || isSecretaire();
    }

    match /media/{docId} {
      allow read: if isBureau();
      allow write: if isCommunicateur() || isSuperAdmin();
    }

    match /editorial_calendar/{docId} {
      allow read, write: if isCommunicateur() || isSuperAdmin();
    }
  }
}
